{% load static %}
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <title>Panel {{ rol }}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    #qr-reader{max-width:400px;margin:0 auto}
    .step-done{background-color:#198754;color:#fff}
    .hidden{display:none}
  </style>
</head>
<body class="bg-light">
<nav class="navbar navbar-expand-sm navbar-dark bg-primary mb-4">
  <div class="container-fluid">
    <span class="navbar-brand mb-0 h1">Panel {{ rol }}</span>
    <div class="ms-auto">
      <span class="text-white me-3">{{ user.username }}</span>
      <a class="btn btn-sm btn-outline-light" href="{% url 'logout' %}">Cerrar sesión</a>
    </div>
  </div>
</nav>

<div class="container">
  <!-- MENÚ DE ACCIONES -->
  <div class="card mb-4">
    <div class="card-body">
      <h5 class="card-title">Seleccione una acción</h5>
      <div class="btn-group flex-wrap" role="group" id="acciones">
        {% if rol == 'SoporteInventarios' %}
          <button class="btn btn-outline-primary" data-accion="inventariar">Inventariar nuevo equipo</button>
        {% elif rol == 'SoporteMantenimiento' %}
          <button class="btn btn-outline-primary" data-accion="revision">Pasar a Revisión</button>
          <button class="btn btn-outline-primary" data-accion="mantenimiento">Pasar a Mantenimiento</button>
          <button class="btn btn-outline-success" data-accion="finalizar">Finalizar Revisión/Mantenimiento</button>
        {% elif rol == 'SoporteClonacion' %}
          <button class="btn btn-outline-primary" data-accion="clonacion">Iniciar Clonación</button>
          <button class="btn btn-outline-success" data-accion="finalizar">Finalizar Clonación</button>
        {% elif rol == 'SoporteMasterizacion' %}
          <button class="btn btn-outline-primary" data-accion="masterizacion">Iniciar Masterización</button>
          <button class="btn btn-outline-success" data-accion="finalizar">Finalizar Masterización</button>
        {% elif rol == 'SoporteEntrega' %}
          <button class="btn btn-outline-success" data-accion="entrega">Entregar equipo</button>
        {% endif %}
      </div>
    </div>
  </div>

  <!-- LECTOR QR (oculto hasta seleccionar acción) -->
  <div id="qr-box" class="text-center mb-4 hidden">
    <div id="qr-reader"></div>
  </div>

  <!-- Historial SIEMPRE visible -->
  <h5>Historial de cambios</h5>
  <div class="table-responsive">
    <table class="table table-sm table-striped align-middle">
      <thead class="table-dark"><tr><th>Código</th><th>Fase nueva</th><th>Fecha/hora</th><th>Estado</th></tr></thead>
      <tbody id="hist"></tbody>
    </table>
  </div>
</div>

<!-- Modal nro_estacion (solo SoporteEntrega) -->
<div class="modal fade" id="modalNro" tabindex="-1">
  <div class="modal-dialog"><form class="modal-content" id="formNro">
    <div class="modal-header"><h5 class="modal-title">Asignar número de estación</h5>
      <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body">
      <label>Número de estación (numérico)</label>
      <input type="number" class="form-control" id="nro_estacion" required>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
      <button type="submit" class="btn btn-primary">Guardar</button>
    </div>
  </form></div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
<script>
  const rol = "{{ rol }}";
  let accion = '';
  let codigoQR = '';
  let procesando = false;
  const qrBox = document.getElementById('qr-box');
  const modal = new bootstrap.Modal(document.getElementById('modalNro'));
  const csrf = '{{ csrf_token }}';

  /* ---------- mostrar / ocultar cámara ---------- */
  function mostrarCamara(mostrar) {
    if (mostrar) {
      procesando = false;
      qrBox.classList.remove('hidden');
      html5QrcodeScanner.clear();
      html5QrcodeScanner.render(onScanSuccess);
    } else {
      qrBox.classList.add('hidden');
      html5QrcodeScanner.clear();
    }
  }

  /* ---------- selección de acción ---------- */
  document.querySelectorAll('#acciones button').forEach(btn => {
    btn.addEventListener('click', e => {
      accion = e.target.dataset.accion;
      mostrarCamara(true);
    });
  });

  /* ---------- historial ---------- */
  function addRow(cod, fase, ok, msg) {
    const fe = new Date().toLocaleString('es-BO');
    const icon = ok ? '✅' : '❌';
    const cl = ok ? 'table-success' : 'table-danger';
    document.getElementById('hist').insertAdjacentHTML('afterbegin',
      `<tr class="${cl}"><td>${cod}</td><td>${fase || '-'}</td><td>${fe}</td><td>${icon} ${msg}</td></tr>`);
  }

  /* ---------- envío al backend ---------- */
  function enviar(payload) {
    fetch("{% url 'qr_scan' %}", {
      method: 'POST',
      headers: {'X-CSRFToken': csrf, 'Content-Type': 'application/json'},
      body: JSON.stringify(payload)
    })
      .then(r => r.json())
      .then(j => {
        addRow(codigoQR, j.nueva_fase, j.ok, j.msg || j.nueva_fase);
        if (!j.ok) alert(j.msg);
        mostrarCamara(false);
      })
      .catch(err => alert('Error red'));
  }

  /* ---------- QR callback ---------- */
  function onScanSuccess(decodedText) {
    if (!accion || procesando) return;
    procesando = true;                   // bloqueo temporal
    codigoQR = decodedText;

    /* ======  NUEVO: CONFIRMACIÓN  ====== */
    // preguntamos al backend cuál sería la nueva fase
    fetch("{% url 'qr_scan' %}", {
      method: 'POST',
      headers: {'X-CSRFToken': csrf, 'Content-Type': 'application/json'},
      body: JSON.stringify({codigo: codigoQR, accion: accion, preview: true})
    })
      .then(r => r.json())
      .then(j => {
        if (!j.ok) { alert(j.msg); procesando = false; return; }

        const anterior = j.fase_anterior || '—';
        const nuevo    = j.nueva_fase;
        const msg = `¿Confirma el cambio de fase?\n\nEstado anterior: ${anterior}\nNuevo estado: ${nuevo}`;
        if (confirm(msg)) {
          // usuario confirma → enviamos definitivamente
          if (accion === 'entrega') {
            modal.show();
          } else {
            enviar({codigo: codigoQR, accion: accion});
          }
        } else {
          // cancelado
          procesando = false;
        }
      })
      .catch(err => { alert('Error red'); procesando = false; });
  }

  /* ---------- modal guardar ---------- */
  document.getElementById('formNro').addEventListener('submit', e => {
    e.preventDefault();
    const nro = document.getElementById('nro_estacion').value;
    if (!nro) { alert('Ingrese número'); return; }
    enviar({codigo: codigoQR, accion: 'entrega', nro_estacion: nro});
    modal.hide();
    e.target.reset();
  });

  /* ---------- crear lector UNA vez ---------- */
  const html5QrcodeScanner = new Html5QrcodeScanner("qr-reader", {fps: 10, qrbox: 250}, false);
</script>
</body>
</html>
